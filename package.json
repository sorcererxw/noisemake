{
  "name": "noisemake",
  "version": "0.1.1",
  "description": "Controlled text perturbations that make polished text less obviously AI-generated.",
  "type": "module",
  "license": "MIT AND LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorcererxw/noisemake.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "noisemake": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/data/zh-ime-confusions.generated.ts",
    "third_party/rime-luna-pinyin/LICENSE",
    "third_party/rime-luna-pinyin/SOURCE.md",
    "third_party/rime-pinyin-simp/LICENSE",
    "third_party/rime-pinyin-simp/SOURCE.md",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:dist": "pnpm run build && vitest run test/cli.test.ts test/package.test.ts",
    "check": "pnpm run test:unit && pnpm run test:dist",
    "build:zh-confusions": "tsx tools/build-zh-ime-confusions.ts",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsdown": "^0.21.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
