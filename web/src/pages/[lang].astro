---
import PlaygroundApp from "@/components/PlaygroundApp";
import "../styles/global.css";

export const prerender = false;

const lang = Astro.params.lang;

if (lang !== "zh" && lang !== "en") {
  return Astro.redirect("/en", 302);
}

const title = lang === "zh"
  ? "noisemake - 给评测用的可复现文本噪声"
  : "noisemake - Deterministic text noise for evals";
const description = lang === "zh"
  ? "同一输入、同一种子、同一输出。不是 LLM 改写，而是可控扰动。"
  : "Same input, same seed, same output. Not an LLM rewrite. Controlled perturbation.";
---

<html lang={lang} class="theme-boot">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:inline>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 0 8px;
      }

      .brand-lockup {
        display: inline-flex;
        width: 135px;
        align-items: center;
        gap: 8px;
        color: inherit;
        font-size: 1.25rem;
        font-weight: 600;
        text-decoration: none;
      }

      .noise-face {
        display: block;
        width: 24px;
        height: 24px;
        flex: 0 0 auto;
      }

      .switches {
        display: flex;
        min-width: 0;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
      }

      .language-trigger,
      .theme-switch-control {
        min-height: 44px;
        color: inherit;
        font: inherit;
      }

      .language-trigger {
        display: inline-flex;
        width: 38px;
        align-items: center;
        justify-content: center;
        gap: 3px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        padding: 0 4px;
      }

      .control-divider {
        width: 1px;
        height: 16px;
        background: currentColor;
        opacity: 0.2;
      }

      .theme-switch-control {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .theme-toggle-button {
        display: inline-flex;
        width: 36px;
        height: 36px;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 8px;
        padding: 0;
        color: inherit;
      }

      .theme-toggle-button:not(:hover) {
        background-color: transparent;
      }

      .theme-icon {
        display: block;
      }

      .theme-icon-moon {
        display: none;
      }

      .dark .theme-icon-sun {
        display: none;
      }

      .dark .theme-icon-moon {
        display: block;
      }

      @media (max-width: 767px) {
        .site-header {
          align-items: flex-start;
          flex-direction: column;
          padding-top: 16px;
        }

        .switches {
          justify-content: flex-start;
          gap: 4px 8px;
        }
      }
    </style>
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem("noisemake-theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : prefersDark
              ? "dark"
              : "light";
        document.documentElement.classList.toggle("dark", theme === "dark");
      })();
    </script>
  </head>
  <body>
    <PlaygroundApp lang={lang} client:load />
  </body>
</html>
