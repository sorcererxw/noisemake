{
	"compatibility_date": "2026-04-13",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"routes": [
		{
			"pattern": "noisemake.xyz",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": false
	}
}
